# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# This file is deliberately short. A variable is added here in the same step
# that adds the code reading it, so every entry below has a live consumer.
# Variables named in CLAUDE.md but not yet listed (DATABASE_URL, JWT_SECRET,
# HOLD_TTL_SECONDS, OFFER_TTL_SECONDS, EMAIL_BACKEND, the SMTP settings,
# FRONTEND_BASE_URL, RATE_LIMIT_*) land with the step that consumes them.

# --- Local Postgres, read by docker-compose.yml -----------------------------

# Role that owns the local development database.
POSTGRES_USER=tbs
# Local-only password. Production credentials come from the Render environment.
POSTGRES_PASSWORD=tbs
# Database created on first container start.
POSTGRES_DB=tbs
# Host port mapped to the container's 5432. Change if 5432 is already taken.
POSTGRES_PORT=5432
