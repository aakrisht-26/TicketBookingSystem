# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# This file is deliberately short. A variable is added here in the same step
# that adds the code reading it, so every entry below has a live consumer.
# Variables named in CLAUDE.md but not yet listed (JWT_SECRET, HOLD_TTL_SECONDS,
# OFFER_TTL_SECONDS, EMAIL_BACKEND, the SMTP settings, FRONTEND_BASE_URL,
# RATE_LIMIT_*) land with the step that consumes them.
#
# TEST_DATABASE_URL is read only by the test suite, which falls back to
# DATABASE_URL when it is unset. Set it when you want tests kept away from the
# database the application is using.

# --- Application, read by app/settings.py -----------------------------------

# One of: development, test, production. Controls log rendering. Anything
# other than development emits JSON, because a log aggregator cannot parse the
# human-readable console format.
ENVIRONMENT=development
# Root log level, a standard library level name: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# PostgreSQL connection URL, read by the application engine and by Alembic.
# Production uses the Neon *pooled* endpoint, the host containing "-pooler",
# not the direct one. Paste the string the provider gives you: a plain
# postgresql:// scheme is normalised onto the driver this project uses.
DATABASE_URL=postgresql://tbs:tbs@localhost:5432/tbs
# Connections this process holds open. The pooled endpoint is itself PgBouncer,
# so this stays small and stable rather than bursting; overflow is refused
# rather than queued somewhere invisible.
DB_POOL_SIZE=5
# Discard a pooled connection older than this, in seconds. Neon closes idle
# connections aggressively, so a modest value avoids handing out one the server
# has already given up on.
DB_POOL_RECYCLE_SECONDS=300
# Bound on a connection attempt, in seconds. The readiness probe's own budget
# is derived from it and is deliberately a few seconds longer, so the driver
# reports the failure before the outer timeout fires and erases the diagnosis.
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Local Postgres, read by docker-compose.yml -----------------------------

# Role that owns the local development database.
POSTGRES_USER=tbs
# Local-only password. Production credentials come from the Render environment.
POSTGRES_PASSWORD=tbs
# Database created on first container start.
POSTGRES_DB=tbs
# Host port mapped to the container's 5432. Change if 5432 is already taken.
POSTGRES_PORT=5432
