# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# This file is deliberately short. A variable is added here in the same step
# that adds the code reading it, so every entry below has a live consumer.
# Variables named in CLAUDE.md but not yet listed (JWT_SECRET, HOLD_TTL_SECONDS,
# OFFER_TTL_SECONDS, EMAIL_BACKEND, the SMTP settings, FRONTEND_BASE_URL,
# RATE_LIMIT_*) land with the step that consumes them.

# --- Application, read by app/settings.py -----------------------------------

# One of: development, test, production. Controls log rendering. Anything
# other than development emits JSON, because a log aggregator cannot parse the
# human-readable console format.
ENVIRONMENT=development
# Root log level, a standard library level name: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# PostgreSQL connection URL. Currently read by migrations/env.py; the
# application engine that also reads it arrives with the rest of step 1.
# Production uses the Neon *pooled* endpoint, not the direct one.
DATABASE_URL=postgresql+psycopg://tbs:tbs@localhost:5432/tbs

# --- Local Postgres, read by docker-compose.yml -----------------------------

# Role that owns the local development database.
POSTGRES_USER=tbs
# Local-only password. Production credentials come from the Render environment.
POSTGRES_PASSWORD=tbs
# Database created on first container start.
POSTGRES_DB=tbs
# Host port mapped to the container's 5432. Change if 5432 is already taken.
POSTGRES_PORT=5432
